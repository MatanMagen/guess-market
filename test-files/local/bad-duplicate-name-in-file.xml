<?xml version="1.0" encoding="UTF-8"?>
<!-- Two events under one name: exercise 3 tells events apart by name, so this is refused. -->
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX3-Schema.xsd">
	<GM-events>
		<GM-event name="Twins">
			<description>The first of two.</description>
			<commission type="on-close">5</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-LMSR>
					<b>100</b>
				</GM-LMSR>
			</GM-method>
		</GM-event>
		<GM-event name="  Twins ">
			<description>The second of two, with spaces around the same name.</description>
			<commission type="on-close">5</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-order-book allow-mint="true" initial="10" d="1"/>
			</GM-method>
		</GM-event>
	</GM-events>
</Guess-Market>
