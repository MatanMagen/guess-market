<?xml version="1.0" encoding="UTF-8"?>
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX2-Schema.xsd">
	<GM-events>
		<GM-event name="Too Rich For Him">
			<id>1</id>
			<description>An order book whose initial stock costs more than its maker has.</description>
			<commission type="on-close">5</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-order-book allow-mint="true" initial="1000" d="1"/>
			</GM-method>
		</GM-event>
	</GM-events>
	<GM-users>
		<GM-user name="Pauper">
			<initial-cash>10</initial-cash>
			<GM-market-maker>
				<event id="1"/>
			</GM-market-maker>
		</GM-user>
	</GM-users>
</Guess-Market>
