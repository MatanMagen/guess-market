<?xml version="1.0" encoding="UTF-8"?>
<!-- The lecturer's clob_simulation.html scenario, so the engine can be checked against its numbers. -->
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX3-Schema.xsd">
	<GM-events>
		<GM-event name="Will it rain tomorrow ?">
			<description>A binary YES / NO prediction market, traded through an order book.</description>
			<commission type="on-purchase">1</commission>
			<GM-options>
				<GM-option>YES</GM-option>
				<GM-option>NO</GM-option>
			</GM-options>
			<GM-method>
				<GM-order-book allow-mint="true" initial="100" d="1"/>
			</GM-method>
		</GM-event>
	</GM-events>
</Guess-Market>
